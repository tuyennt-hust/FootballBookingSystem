<section class="admin-hero admin-hero-compact"><div class="container"><span class="section-kicker section-kicker-light">DANH MỤC HỆ THỐNG</span><h1>Quản lý khu vực</h1></div></section>
<div class="admin-subnav-shell"><div class="container"><%- include('_nav') %></div></div>
<section class="section admin-section"><div class="container admin-area-layout"><article class="admin-panel"><span class="section-kicker">Thêm khu vực</span><h2>Khu vực mới</h2><form class="admin-stack-form" method="post" action="/admin/khu-vuc"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Tên khu vực<input name="name" maxlength="100" required placeholder="Ví dụ: Bách Khoa"></label><label>Quận / huyện<input name="district" maxlength="100" required placeholder="Ví dụ: Hai Bà Trưng"></label><button class="button button-primary" type="submit">Thêm khu vực</button></form></article>
<article class="admin-panel admin-table-panel"><div class="admin-panel-head"><div><span class="section-kicker">Danh sách</span><h2><%= areas.length %> khu vực</h2></div></div><div class="admin-area-list"><% areas.forEach(a=>{ %><details class="admin-area-item"><summary><span><strong><%= a.ten_khu_vuc %></strong><small><%= a.ma_khu_vuc %> · <%= a.quan_huyen %></small></span><span><%= a.so_san %> sân · <%= a.so_luot_dat %> lượt đặt</span></summary><div class="admin-area-actions"><form class="admin-inline-edit" method="post" action="/admin/khu-vuc/<%= encodeURIComponent(a.ma_khu_vuc) %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input name="name" value="<%= a.ten_khu_vuc %>" required maxlength="100"><input name="district" value="<%= a.quan_huyen %>" required maxlength="100"><button class="button button-outline" type="submit">Lưu</button></form><form method="post" action="/admin/khu-vuc/<%= encodeURIComponent(a.ma_khu_vuc) %>/xoa"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="admin-text-button danger" type="submit" <%= a.so_san>0?'disabled title="Khu vực đang có sân"':'' %>>Xóa khu vực</button></form></div></details><% }) %></div></article></div></section>