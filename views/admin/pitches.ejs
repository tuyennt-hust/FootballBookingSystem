<section class="admin-hero admin-hero-compact"><div class="container"><span class="section-kicker section-kicker-light">GIÁM SÁT VẬN HÀNH</span><h1>Toàn bộ sân bóng</h1></div></section>
<div class="admin-subnav-shell"><div class="container"><%- include('_nav') %></div></div><section class="section admin-section"><div class="container">
<form class="admin-filter" method="get"><label>Tìm kiếm<input name="q" value="<%= filters.q %>" placeholder="Mã, tên sân, chủ sân..."></label><label>Loại sân<select name="type"><option value="">Tất cả</option><% pitchTypes.forEach(t=>{ %><option <%= filters.type===t?'selected':'' %> value="<%= t %>"><%= t %></option><% }) %></select></label><label>Trạng thái<select name="status"><option value="">Tất cả</option><% statuses.forEach(s=>{ %><option <%= filters.status===s?'selected':'' %> value="<%= s %>"><%= s %></option><% }) %></select></label><button class="button button-primary">Lọc</button><a class="button button-ghost" href="/admin/san-bong">Xóa lọc</a></form>
<div class="admin-panel admin-table-panel"><div class="admin-panel-head"><h2><%= pagination.totalItems %> sân bóng</h2><small>Trang <%= pagination.page %>/<%= pagination.totalPages %></small></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Sân</th><th>Loại</th><th>Chủ sân</th><th>Khu vực</th><th>Giá ca thường</th><th>Lượt đặt</th><th>Trạng thái</th></tr></thead><tbody><% pitches.forEach(p=>{ %><tr><td><a href="/san-bong/<%= encodeURIComponent(p.ma_san) %>"><strong><%= p.ten_san %></strong></a><br><small><%= p.ma_san %></small></td><td><%= p.loai_san %></td><td><%= p.ten_chu_san %></td><td><%= p.ten_khu_vuc %><br><small><%= p.quan_huyen %></small></td><td><%= formatMoney(p.gia_thue) %></td><td><%= p.so_luot_dat %></td><td><span class="admin-badge <%= p.statusMeta.tone %>"><%= p.statusMeta.label %></span></td></tr><% }) %><% if(!pitches.length){ %><tr><td colspan="7" class="admin-empty">Không có sân phù hợp.</td></tr><% } %></tbody></table></div></div>
<% if(pagination.totalPages>1){const qs=new URLSearchParams();if(filters.q)qs.set('q',filters.q);if(filters.type)qs.set('type',filters.type);if(filters.status)qs.set('status',filters.status);%><div class="admin-pagination"><%if(pagination.page>1){qs.set('page',pagination.page-1);%><a href="?<%=qs.toString()%>">← Trang trước</a><%}%><span>Trang <%=pagination.page%> / <%=pagination.totalPages%></span><%if(pagination.page<pagination.totalPages){qs.set('page',pagination.page+1);%><a href="?<%=qs.toString()%>">Trang sau →</a><%}%></div><%}%>
</div></section>