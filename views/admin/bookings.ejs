<section class="admin-hero admin-hero-compact"><div class="container"><span class="section-kicker section-kicker-light">GIÁM SÁT GIAO DỊCH</span><h1>Toàn bộ đơn đặt sân</h1></div></section>
<div class="admin-subnav-shell"><div class="container"><%- include('_nav') %></div></div><section class="section admin-section"><div class="container">
<form class="admin-filter" method="get"><label>Tìm kiếm<input name="q" value="<%= filters.q %>" placeholder="Mã đơn, khách, sân..."></label><label>Trạng thái đơn<select name="bookingStatus"><option value="">Tất cả</option><%bookingStatuses.forEach(s=>{%><option <%=filters.bookingStatus===s?'selected':''%> value="<%=s%>"><%=s%></option><%})%></select></label><label>Thanh toán<select name="paymentStatus"><option value="">Tất cả</option><%paymentStatuses.forEach(s=>{%><option <%=filters.paymentStatus===s?'selected':''%> value="<%=s%>"><%=s%></option><%})%></select></label><button class="button button-primary">Lọc</button><a class="button button-ghost" href="/admin/don-dat-san">Xóa lọc</a></form>
<div class="admin-panel admin-table-panel"><div class="admin-panel-head"><h2><%=pagination.totalItems%> đơn</h2><small>Trang <%=pagination.page%>/<%=pagination.totalPages%></small></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Mã</th><th>Khách hàng</th><th>Sân / chủ sân</th><th>Ngày giờ</th><th>Đơn</th><th>Thanh toán</th><th>Tổng tiền</th></tr></thead><tbody><%bookings.forEach(b=>{%><tr><td><strong><%=b.ma_dat_san%></strong></td><td><%=b.ten_khach_hang%><br><small><%=b.sdt||'—'%></small></td><td><%=b.ten_san%><br><small><%=b.ten_chu_san%></small></td><td><%=b.ngay_dat_label%><br><small><%=b.timeLabel%></small></td><td><span class="admin-badge <%=b.bookingStatus.tone%>"><%=b.bookingStatus.label%></span></td><td><span class="admin-badge <%=b.paymentStatus.tone%>"><%=b.paymentStatus.label%></span></td><td><%=formatMoney(b.tong_tien)%></td></tr><%})%><%if(!bookings.length){%><tr><td colspan="7" class="admin-empty">Không có đơn phù hợp.</td></tr><%}%></tbody></table></div></div>
<% if(pagination.totalPages>1){const qs=new URLSearchParams();if(filters.q)qs.set('q',filters.q);if(filters.bookingStatus)qs.set('bookingStatus',filters.bookingStatus);if(filters.paymentStatus)qs.set('paymentStatus',filters.paymentStatus);%><div class="admin-pagination"><%if(pagination.page>1){qs.set('page',pagination.page-1);%><a href="?<%=qs.toString()%>">← Trang trước</a><%}%><span>Trang <%=pagination.page%> / <%=pagination.totalPages%></span><%if(pagination.page<pagination.totalPages){qs.set('page',pagination.page+1);%><a href="?<%=qs.toString()%>">Trang sau →</a><%}%></div><%}%>
</div></section>