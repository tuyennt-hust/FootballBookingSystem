<section class="admin-hero admin-hero-compact"><div class="container"><span class="section-kicker section-kicker-light">TÀI CHÍNH</span><h1>Toàn bộ hóa đơn</h1></div></section>
<div class="admin-subnav-shell"><div class="container"><%- include('_nav') %></div></div><section class="section admin-section"><div class="container"><form class="admin-filter admin-filter-short" method="get"><label>Trạng thái thanh toán<select name="status"><option value="">Tất cả</option><%paymentStatuses.forEach(s=>{%><option <%=filters.status===s?'selected':''%> value="<%=s%>"><%=s%></option><%})%></select></label><button class="button button-primary">Lọc</button><a class="button button-ghost" href="/admin/hoa-don">Xóa lọc</a></form>
<div class="admin-panel admin-table-panel"><div class="admin-panel-head"><h2><%=pagination.totalItems%> hóa đơn</h2></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Hóa đơn</th><th>Đơn đặt</th><th>Khách hàng</th><th>Sân</th><th>Ngày</th><th>Tiền sân</th><th>Dịch vụ</th><th>Tổng</th><th>Trạng thái</th></tr></thead><tbody><%invoices.forEach(i=>{%><tr><td><strong><%=i.ma_thanh_toan%></strong></td><td><%=i.ma_dat_san%></td><td><%=i.ten_khach_hang%></td><td><%=i.ten_san%></td><td><%=i.ngay_dat_label%></td><td><%=formatMoney(i.tong_tien_san)%></td><td><%=formatMoney(i.tong_tien_dich_vu)%></td><td><strong><%=formatMoney(i.tong_tien)%></strong></td><td><span class="admin-badge <%=i.paymentStatus.tone%>"><%=i.paymentStatus.label%></span></td></tr><%})%><%if(!invoices.length){%><tr><td colspan="9" class="admin-empty">Không có hóa đơn phù hợp.</td></tr><%}%></tbody></table></div></div>
<%if(pagination.totalPages>1){const qs=new URLSearchParams();if(filters.status)qs.set('status',filters.status);%><div class="admin-pagination"><%if(pagination.page>1){qs.set('page',pagination.page-1);%><a href="?<%=qs.toString()%>">← Trang trước</a><%}%><span>Trang <%=pagination.page%> / <%=pagination.totalPages%></span><%if(pagination.page<pagination.totalPages){qs.set('page',pagination.page+1);%><a href="?<%=qs.toString()%>">Trang sau →</a><%}%></div><%}%></div></section>