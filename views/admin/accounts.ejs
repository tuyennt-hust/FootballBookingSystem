<section class="admin-hero admin-hero-compact"><div class="container"><span class="section-kicker section-kicker-light">QUẢN TRỊ TÀI KHOẢN</span><h1>Tài khoản hệ thống</h1></div></section>
<div class="admin-subnav-shell"><div class="container"><%- include('_nav') %></div></div>
<section class="section admin-section"><div class="container">
<form class="admin-filter" method="get" action="/admin/tai-khoan"><label>Tìm kiếm<input name="q" value="<%= filters.q %>" placeholder="Tên, username hoặc mã..."></label><label>Vai trò<select name="role"><option value="">Tất cả</option><% roles.forEach(r=>{ %><option value="<%= r.value %>" <%= filters.role===r.value?'selected':'' %>><%= r.label %></option><% }) %></select></label><label>Trạng thái<select name="status"><option value="">Tất cả</option><% statuses.forEach(s=>{ %><option value="<%= s %>" <%= filters.status===s?'selected':'' %>><%= s==='Hoat dong'?'Hoạt động':'Bị khóa' %></option><% }) %></select></label><button class="button button-primary" type="submit">Lọc</button><a class="button button-ghost" href="/admin/tai-khoan">Xóa lọc</a></form>
<div class="admin-panel admin-table-panel"><div class="admin-panel-head"><div><span class="section-kicker">Kết quả</span><h2><%= pagination.totalItems %> tài khoản</h2></div><small>Trang <%= pagination.page %>/<%= pagination.totalPages %></small></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Tài khoản</th><th>Họ tên</th><th>Vai trò</th><th>Liên hệ</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
<% accounts.forEach(a=>{ %><tr><td><strong><%= a.ten_dang_nhap %></strong><br><small><%= a.ma_tai_khoan %></small></td><td><%= a.ho_va_ten %></td><td><%= a.roleLabel %></td><td><%= a.sdt || '—' %></td><td><span class="admin-badge <%= a.statusMeta.tone %>"><%= a.statusMeta.label %></span></td><td><% if(a.canChangeStatus){ %><form method="post" action="/admin/tai-khoan/<%= encodeURIComponent(a.ma_tai_khoan) %>/trang-thai"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="<%= a.trang_thai==='Hoat dong'?'Bi khoa':'Hoat dong' %>"><button class="admin-text-button <%= a.trang_thai==='Hoat dong'?'danger':'success' %>" type="submit"><%= a.trang_thai==='Hoat dong'?'Khóa':'Mở khóa' %></button></form><% } else { %><small>Được bảo vệ</small><% } %></td></tr><% }) %>
<% if(!accounts.length){ %><tr><td colspan="6" class="admin-empty">Không tìm thấy tài khoản phù hợp.</td></tr><% } %></tbody></table></div></div>
<% if(pagination.totalPages>1){ const qs=new URLSearchParams(); if(filters.q)qs.set('q',filters.q);if(filters.role)qs.set('role',filters.role);if(filters.status)qs.set('status',filters.status); %><div class="admin-pagination"><% if(pagination.page>1){ qs.set('page',pagination.page-1); %><a href="?<%= qs.toString() %>">← Trang trước</a><% } %><span>Trang <%= pagination.page %> / <%= pagination.totalPages %></span><% if(pagination.page<pagination.totalPages){ qs.set('page',pagination.page+1); %><a href="?<%= qs.toString() %>">Trang sau →</a><% } %></div><% } %>
</div></section>