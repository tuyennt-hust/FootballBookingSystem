<section class="admin-hero admin-hero-compact"><div class="container"><span class="section-kicker section-kicker-light">REPORTING</span><h1>Báo cáo và thống kê</h1><%- include('_nav') %></div></section><section class="section admin-section"><div class="container">
<div class="admin-report-summary"><article><span>Tỷ lệ hủy đơn</span><strong><%= cancellation.rate.toFixed(2) %>%</strong><small><%= cancellation.cancelled %>/<%= cancellation.total %> đơn</small></article><article><span>Khách VIP</span><strong><%= segmentCounts.VIP||0 %></strong><small>Chi tiêu ≥ 2 triệu</small></article><article><span>Khách thân thiết</span><strong><%= segmentCounts['Than thiet']||0 %></strong><small>Chi tiêu ≥ 500 nghìn</small></article><article><span>Khách tiềm năng</span><strong><%= segmentCounts['Tiem nang']||0 %></strong><small>Nhóm còn lại</small></article></div>
<div class="admin-report-grid"><article class="admin-panel admin-table-panel"><div class="admin-panel-head"><h2>Top khách hàng chi tiêu</h2></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>#</th><th>Khách hàng</th><th>Điện thoại</th><th>Chi tiêu</th></tr></thead><tbody><%topCustomers.forEach(c=>{%><tr><td><%=c.xep_hang%></td><td><strong><%=c.ho_va_ten%></strong><br><small><%=c.ma_khach_hang%></small></td><td><%=c.sdt||'—'%></td><td><%=formatMoney(c.tong_chi_tieu)%></td></tr><%})%></tbody></table></div></article>
<article class="admin-panel admin-table-panel"><div class="admin-panel-head"><h2>Doanh thu theo tháng</h2></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Tháng</th><th>Lượt đặt</th><th>Doanh thu</th></tr></thead><tbody><%monthly.forEach(m=>{%><tr><td><%=String(m.thang).slice(0,10)%></td><td><%=m.so_luot_dat%></td><td><%=formatMoney(m.tong_doanh_thu)%></td></tr><%})%><%if(!monthly.length){%><tr><td colspan="3" class="admin-empty">Chưa có doanh thu đã thanh toán.</td></tr><%}%></tbody></table></div></article></div>
<div class="admin-report-grid"><article class="admin-panel admin-table-panel"><div class="admin-panel-head"><h2>Doanh thu theo sân</h2></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Sân</th><th>Lượt đặt</th><th>Doanh thu</th></tr></thead><tbody><%pitches.forEach(p=>{%><tr><td><strong><%=p.ten_san%></strong><br><small><%=p.ma_san%></small></td><td><%=p.so_luot_dat%></td><td><%=formatMoney(p.tong_doanh_thu)%></td></tr><%})%></tbody></table></div></article>
<article class="admin-panel admin-table-panel"><div class="admin-panel-head"><h2>Doanh thu theo khu vực</h2></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Khu vực</th><th>Sân</th><th>Lượt đặt</th><th>Doanh thu</th></tr></thead><tbody><%areas.forEach(a=>{%><tr><td><strong><%=a.ten_khu_vuc%></strong><br><small><%=a.quan_huyen%></small></td><td><%=a.so_luong_san%></td><td><%=a.so_luot_dat%></td><td><%=formatMoney(a.tong_doanh_thu)%></td></tr><%})%></tbody></table></div></article></div>
<div class="admin-panel admin-table-panel"><div class="admin-panel-head"><h2>Dịch vụ bán chạy</h2></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Dịch vụ</th><th>Số lượng</th><th>Doanh thu</th></tr></thead><tbody><%services.forEach(s=>{%><tr><td><strong><%=s.ten_dv%></strong></td><td><%=s.tong_so_luong_ban%></td><td><%=formatMoney(s.doanh_thu_dich_vu)%></td></tr><%})%><%if(!services.length){%><tr><td colspan="3" class="admin-empty">Chưa có dữ liệu dịch vụ đã thanh toán.</td></tr><%}%></tbody></table></div></div>
</div></section>