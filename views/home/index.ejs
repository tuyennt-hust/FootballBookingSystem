<section class="hero-section">
  <div class="container hero-grid">
    <div class="hero-content">
      <span class="section-kicker">Nền tảng đặt sân trực tuyến</span>
      <h1>Tìm sân phù hợp.<br><span>Đặt lịch nhanh chóng.</span></h1>
      <p>Tra cứu sân đang hoạt động theo khu vực và loại sân. Thông tin giá thuê, địa chỉ và chủ sân được hiển thị rõ ràng từ cơ sở dữ liệu.</p>

      <form class="hero-search" action="/san-bong" method="get">
        <div class="field-group">
          <label for="hero-area">Khu vực</label>
          <select id="hero-area" name="area">
            <option value="">Tất cả khu vực</option>
            <% areas.forEach((area) => { %>
              <option value="<%= area.ma_khu_vuc %>"><%= area.ten_khu_vuc %> - <%= area.quan_huyen %></option>
            <% }) %>
          </select>
        </div>
        <div class="field-group">
          <label for="hero-type">Loại sân</label>
          <select id="hero-type" name="type">
            <option value="">Tất cả loại sân</option>
            <% pitchTypes.forEach((type) => { %>
              <option value="<%= type %>"><%= type %></option>
            <% }) %>
          </select>
        </div>
        <button class="button button-primary search-submit" type="submit">Tìm sân ngay</button>
      </form>

      <div class="hero-stats" aria-label="Thống kê hệ thống">
        <div><strong><%= stats.so_san_hoat_dong %>+</strong><span>Sân hoạt động</span></div>
        <div><strong><%= stats.so_khu_vuc %>+</strong><span>Khu vực</span></div>
        <div><strong><%= stats.so_chu_san %>+</strong><span>Chủ sân</span></div>
      </div>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="hero-glow"></div>
      <img src="/images/hero-football.svg" alt="">
      <div class="floating-card floating-card-top">
        <span>✓</span>
        <div><strong>Dữ liệu trực tiếp</strong><small>Từ PostgreSQL</small></div>
      </div>
      <div class="floating-card floating-card-bottom">
        <span>⚽</span>
        <div><strong>Đặt sân tiện lợi</strong><small>Quản lý rõ ràng</small></div>
      </div>
    </div>
  </div>
</section>

<section class="section" aria-labelledby="featured-title">
  <div class="container">
    <div class="section-heading heading-row">
      <div>
        <span class="section-kicker">Sân nổi bật</span>
        <h2 id="featured-title">Khám phá sân đang hoạt động</h2>
        <p>Các sân bên dưới được đọc trực tiếp từ bảng <code>san_bong</code>.</p>
      </div>
      <a class="text-link" href="/san-bong">Xem tất cả sân <span>→</span></a>
    </div>

    <% if (featuredPitches.length > 0) { %>
      <div class="pitch-grid">
        <% featuredPitches.forEach((pitch) => { %>
          <%- include('../partials/pitch-card', { pitch }) %>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <h3>Chưa có sân đang hoạt động</h3>
        <p>Hãy kiểm tra dữ liệu trong bảng <code>san_bong</code>.</p>
      </div>
    <% } %>
  </div>
</section>

<section class="section section-muted" id="quy-trinh" aria-labelledby="process-title">
  <div class="container">
    <div class="section-heading centered">
      <span class="section-kicker">Quy trình đơn giản</span>
      <h2 id="process-title">Ba bước để có một trận bóng</h2>
      <p>Phần giao diện đặt sân chi tiết sẽ được kết nối ở các phần nghiệp vụ tiếp theo.</p>
    </div>

    <div class="process-grid">
      <article class="process-card">
        <span class="process-number">01</span>
        <div class="process-icon">⌕</div>
        <h3>Tìm sân</h3>
        <p>Lọc danh sách theo khu vực, loại sân hoặc tên sân mong muốn.</p>
      </article>
      <article class="process-card">
        <span class="process-number">02</span>
        <div class="process-icon">▣</div>
        <h3>Chọn lịch</h3>
        <p>Chọn ngày và khung giờ còn trống phù hợp với đội bóng.</p>
      </article>
      <article class="process-card">
        <span class="process-number">03</span>
        <div class="process-icon">✓</div>
        <h3>Xác nhận</h3>
        <p>Theo dõi trạng thái đơn đặt, dịch vụ đi kèm và thanh toán.</p>
      </article>
    </div>
  </div>
</section>

<section class="section cta-section">
  <div class="container cta-card">
    <div>
      <span class="section-kicker section-kicker-light">Sẵn sàng ra sân?</span>
      <h2>Tìm sân bóng phù hợp cho đội của bạn</h2>
      <p>Bắt đầu bằng danh sách các sân đang hoạt động trong hệ thống.</p>
    </div>
    <a class="button button-light" href="/san-bong">Khám phá sân bóng</a>
  </div>
</section>
