<section class="auth-section auth-section-register">
  <div class="container auth-grid auth-grid-register auth-grid-enhanced">
    <div class="auth-panel auth-panel-register">
      <div class="auth-heading">
        <span class="section-kicker">Tài khoản khách hàng</span>
        <h1>Tạo tài khoản mới</h1>
        <p>Tạo tài khoản để bắt đầu tìm sân, chọn lịch thi đấu phù hợp và theo dõi đơn đặt trong một không gian duy nhất.</p>
      </div>

      <% if (formError) { %>
        <div class="alert alert-error auth-alert" role="alert">
          <span class="alert-icon" aria-hidden="true">!</span>
          <span><%= formError %></span>
        </div>
      <% } %>

      <form class="auth-form" action="/dang-ky" method="post" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-field">
          <label for="fullName">Họ và tên</label>
          <input
            id="fullName"
            name="fullName"
            type="text"
            value="<%= formData.fullName %>"
            autocomplete="name"
            maxlength="100"
            required
            autofocus
          >
        </div>

        <div class="form-field">
          <label for="phone">Số điện thoại</label>
          <input
            id="phone"
            name="phone"
            type="tel"
            value="<%= formData.phone %>"
            autocomplete="tel"
            inputmode="numeric"
            maxlength="11"
            required
          >
        </div>

        <div class="form-field">
          <label for="username">Tên đăng nhập</label>
          <input
            id="username"
            name="username"
            type="text"
            value="<%= formData.username %>"
            autocomplete="username"
            minlength="4"
            maxlength="50"
            pattern="[A-Za-z0-9._]+"
            required
          >
        </div>

        <div class="auth-form-columns">
          <div class="form-field">
            <label for="password">Mật khẩu</label>
            <div class="password-field">
              <input
                id="password"
                name="password"
                type="password"
                autocomplete="new-password"
                minlength="6"
                required
              >
              <button type="button" data-password-toggle="password" aria-label="Hiện mật khẩu">Hiện</button>
            </div>
          </div>

          <div class="form-field">
            <label for="confirmPassword">Xác nhận mật khẩu</label>
            <div class="password-field">
              <input
                id="confirmPassword"
                name="confirmPassword"
                type="password"
                autocomplete="new-password"
                minlength="6"
                required
              >
              <button type="button" data-password-toggle="confirmPassword" aria-label="Hiện mật khẩu">Hiện</button>
            </div>
          </div>
        </div>

        <button class="button button-primary button-block auth-submit" type="submit">
          Tạo tài khoản
        </button>
      </form>

      <p class="auth-switch">
        Đã có tài khoản?
        <a href="/dang-nhap">Quay lại đăng nhập</a>
      </p>
    </div>

    <aside class="auth-side auth-side-photo auth-side-register" aria-label="Thông tin đăng ký">
      <div class="auth-side-media" aria-hidden="true">
        <img src="/images/auth-login-stadium.webp" alt="" width="900" height="601">
      </div>
      <div class="auth-side-content">
        <span class="auth-side-badge">Tạo tài khoản miễn phí</span>
        <h2>Bắt đầu hành trình đặt sân với một tài khoản gọn gàng và bảo mật.</h2>
        <p>Tài khoản mới sẽ được tạo với vai trò <strong>Khách hàng</strong> để bạn có thể đặt sân, chọn thêm dịch vụ và theo dõi thanh toán ngay sau khi đăng ký.</p>
      </div>
    </aside>
  </div>
</section>
