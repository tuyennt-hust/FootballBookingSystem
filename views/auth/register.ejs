<section class="auth-section">
  <div class="container auth-grid auth-grid-register">
    <div class="auth-panel">
      <div class="auth-heading">
        <span class="section-kicker">Tài khoản khách hàng</span>
        <h1>Tạo tài khoản mới</h1>
        <p>Thông tin này được dùng để nhận diện khách hàng và quản lý các đơn đặt sân sau này.</p>
      </div>

      <% if (formError) { %>
        <div class="alert alert-error auth-alert" role="alert">
          <span class="alert-icon" aria-hidden="true">!</span>
          <span><%= formError %></span>
        </div>
      <% } %>

      <form class="auth-form" action="/dang-ky" method="post" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-field">
          <label for="fullName">Họ và tên</label>
          <input
            id="fullName"
            name="fullName"
            type="text"
            value="<%= formData.fullName %>"
            autocomplete="name"
            maxlength="100"
            required
            autofocus
            placeholder="Nguyễn Văn A"
          >
        </div>

        <div class="form-field">
          <label for="phone">Số điện thoại</label>
          <input
            id="phone"
            name="phone"
            type="tel"
            value="<%= formData.phone %>"
            autocomplete="tel"
            inputmode="numeric"
            maxlength="11"
            required
            placeholder="0987654321"
          >
        </div>

        <div class="form-field">
          <label for="username">Tên đăng nhập</label>
          <input
            id="username"
            name="username"
            type="text"
            value="<%= formData.username %>"
            autocomplete="username"
            minlength="4"
            maxlength="50"
            pattern="[A-Za-z0-9._]+"
            required
            placeholder="Chữ, số, dấu chấm hoặc gạch dưới"
          >
        </div>

        <div class="auth-form-columns">
          <div class="form-field">
            <label for="password">Mật khẩu</label>
            <div class="password-field">
              <input
                id="password"
                name="password"
                type="password"
                autocomplete="new-password"
                minlength="6"
                required
                placeholder="Tối thiểu 6 ký tự"
              >
              <button type="button" data-password-toggle="password" aria-label="Hiện mật khẩu">Hiện</button>
            </div>
          </div>

          <div class="form-field">
            <label for="confirmPassword">Xác nhận mật khẩu</label>
            <div class="password-field">
              <input
                id="confirmPassword"
                name="confirmPassword"
                type="password"
                autocomplete="new-password"
                minlength="6"
                required
                placeholder="Nhập lại mật khẩu"
              >
              <button type="button" data-password-toggle="confirmPassword" aria-label="Hiện mật khẩu">Hiện</button>
            </div>
          </div>
        </div>

        <button class="button button-primary button-block auth-submit" type="submit">
          Tạo tài khoản
        </button>
      </form>

      <p class="auth-switch">
        Đã có tài khoản?
        <a href="/dang-nhap">Quay lại đăng nhập</a>
      </p>
    </div>

    <aside class="auth-side auth-side-register" aria-label="Thông tin đăng ký">
      <span class="auth-side-badge">Tạo tài khoản miễn phí</span>
      <h2>Sẵn sàng đặt sân trong vài bước đơn giản.</h2>
      <p>Tài khoản đăng ký tại đây mặc định có vai trò <strong>Khách hàng</strong>.</p>
      <div class="security-note">
        <span aria-hidden="true">🔒</span>
        <div>
          <strong>Mật khẩu được bảo vệ</strong>
          <small>Tài khoản mới được lưu bằng mã băm bcrypt, không lưu mật khẩu dạng rõ.</small>
        </div>
      </div>
    </aside>
  </div>
</section>
