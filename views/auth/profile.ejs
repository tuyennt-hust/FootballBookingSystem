<section class="page-hero account-hero">
  <div class="container page-hero-inner">
    <div>
      <span class="section-kicker section-kicker-light">Tài khoản đang đăng nhập</span>
      <h1>Xin chào, <%= user.fullName %></h1>
      <p>Phiên đăng nhập được lưu trên PostgreSQL và tự hết hạn sau thời gian cấu hình.</p>
    </div>
    <div class="account-avatar" aria-hidden="true">
      <%= user.fullName ? user.fullName.charAt(0).toUpperCase() : 'U' %>
    </div>
  </div>
</section>

<section class="section account-section">
  <div class="container account-layout">
    <article class="account-card">
      <div class="account-card-heading">
        <div>
          <span class="section-kicker">Thông tin cá nhân</span>
          <h2>Hồ sơ tài khoản</h2>
        </div>
        <span class="role-badge"><%= user.roleLabel %></span>
      </div>

      <dl class="account-details">
        <div>
          <dt>Mã tài khoản</dt>
          <dd><%= user.accountId %></dd>
        </div>
        <div>
          <dt>Tên đăng nhập</dt>
          <dd><%= user.username %></dd>
        </div>
        <div>
          <dt>Họ và tên</dt>
          <dd><%= user.fullName %></dd>
        </div>
        <div>
          <dt>Số điện thoại</dt>
          <dd><%= user.phone || 'Chưa cập nhật' %></dd>
        </div>
        <% if (user.customerId) { %>
          <div>
            <dt>Mã khách hàng</dt>
            <dd><%= user.customerId %></dd>
          </div>
        <% } %>
        <% if (user.ownerId) { %>
          <div>
            <dt>Mã chủ sân</dt>
            <dd><%= user.ownerId %></dd>
          </div>
        <% } %>
      </dl>
    </article>

    <aside class="account-actions-card">
      <h2>Chức năng tài khoản</h2>
      <% if (user.role === 'Khach hang') { %>
        <p>Quản lý các đơn đã tạo hoặc tiếp tục tìm sân phù hợp.</p>
        <a class="button button-primary button-block" href="/lich-su-dat-san">Lịch sử đặt sân</a>
      <% } else if (user.role === 'Chu san') { %>
        <p>Quản lý sân bóng và xác nhận các đơn đặt sân thuộc tài khoản của bạn.</p>
        <a class="button button-primary button-block" href="/chu-san">Mở dashboard chủ sân</a>
      <% } else if (user.role === 'Admin') { %>
        <p>Quản lý tài khoản, khu vực, giao dịch và báo cáo toàn hệ thống.</p>
        <a class="button button-primary button-block" href="/admin">Mở dashboard quản trị</a>
      <% } %>
      <a class="button button-outline button-block" href="/san-bong">Tiếp tục tìm sân</a>
      <form action="/dang-xuat" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="button button-ghost button-block" type="submit">Đăng xuất</button>
      </form>
    </aside>
  </div>
</section>
